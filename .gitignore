# Dependencias instaladas (se reinstalan con npm install)
node_modules/

# Variables de entorno (contraseñas, secretos)
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Archivos temporales de Office (Word, Excel, PowerPoint)
# Cuando tienes un .docx abierto, Word crea estos archivos de bloqueo/recuperacion
# que no deben llegar al repo.
~$*.docx
~$*.xlsx
~$*.pptx
~WRL*.tmp
~WRD*.tmp

# Editor
.vscode/
.idea/
*.swp

# Build
dist/
build/

# Cache
.cache/
.parcel-cache/

# Base de datos local (backups)
*.sql.gz
backups/

# Script de limpieza de datos de prueba (uso UNICO antes de la entrega).
# Es destructivo y solo local: NO debe ir al repo.
database/limpieza_para_entrega.sql

# Documentación interna en markdown (notas, planning, manuales en proceso,
# bitácora técnica, mapa del código, bugs conocidos, contexto del proyecto).
# Se mantienen solo en local porque son apoyo del equipo, no entregables.
# Los README.md sí se mantienen porque son la portada del repo y subcarpetas.
*.md
!README.md
!**/README.md

# Respaldos temporales de .docx (se crean al editar la bitácora)
*backup*.docx

# Carpeta docs/ COMPLETA: solo local. Manual, bitácora.docx con evidencias,
# planning, generador, etc. NO van al repo — Martín los maneja en su PC.
docs/
